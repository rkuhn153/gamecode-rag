# --- Re-ranker (OpenRouter chat) ---
# Optional if you only need hybrid order without LLM re-rank.
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...
# RE_RANKER_MODEL=openai/gpt-4o-mini

# --- Embeddings ---
# Backend: openrouter (default) | openai_compatible (local Ollama / LM Studio / vLLM / TEI / etc.)
# EMBEDDING_BACKEND=openrouter
# Default on OpenRouter: qwen/qwen3-embedding-8b (~$0.01/M, strong on code, 32k ctx)
# Older indexes built with openai/text-embedding-3-small must re-ingest after switching.
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Local example (Ollama OpenAI-compatible API):
# EMBEDDING_BACKEND=openai_compatible
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_API_KEY=ollama

# Changing EMBEDDING_MODEL requires re-ingesting every project (vectors are model-specific).
