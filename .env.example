# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# Embeddings (default: cheap general-purpose). Code-specialized models often retrieve
# better for C# (e.g. voyage-code-3 if available on OpenRouter). Changing this requires
# re-running ingest for every project — vectors are not compatible across models.
# EMBEDDING_MODEL=openai/text-embedding-3-small
# RE_RANKER_MODEL=openai/gpt-4o-mini
